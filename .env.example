# Bun loads an untracked .env automatically. Never commit credentials.
PORT=3000
BIND_HOST=127.0.0.1
DATABASE_URL=sqlite://./local/data/site.sqlite
SITE_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Set one to enable /admin. Prefer a hash generated by bun run password:hash.
# Single-quote a hash value to preserve its dollar signs: ADMIN_PASSWORD_HASH='$argon2id$...'
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Optional: actual client download and game status JSON endpoint.
DOWNLOAD_URL=
GAME_STATUS_URL=

# For Docker Compose, set a unique URL-safe password and use PostgreSQL.
# POSTGRES_PASSWORD=
